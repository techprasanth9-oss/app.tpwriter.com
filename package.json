{
  "name": "tp-writer-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "local": "vite --port 3000",
    "dev:dev-api": "vite --port 3000 --mode dev",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:fidelity": "vitest run --config vitest.fidelity.config.ts",
    "fixtures:build": "python3 scripts/fixtures/build_docx_fixtures.py && bash scripts/fixtures/render_reference.sh"
  },
  "dependencies": {
    "@editorjs/editorjs": "^2.30.7",
    "@editorjs/inline-code": "^1.5.1",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-router": "^1.87.3",
    "docx": "^9.12.0",
    "dompurify": "^3.2.4",
    "jszip": "^3.10.2",
    "katex": "0.16.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@tanstack/router-plugin": "^1.87.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
